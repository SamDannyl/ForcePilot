{
  "manifest_version": 3,
  "name": "ForcePilot - Salesforce Autofill & Testing",
  "version": "2.3.0",
  "description": "Simplify Salesforce testing, automate repetitive record creation, capture test evidence, and export test documentation.",
  "incognito": "spanning",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "unlimitedStorage",
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.vf.force.com/*",
    "https://*.force.com/*",
    "https://*.site.com/*",
    "https://*.my.site.com/*",
    "https://*.salesforce-sites.com/*",
    "https://*.salesforce-communities.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.my.salesforce-setup.com/*",
    "https://*.salesforce-experience.com/*",
    "https://*.salesforce.app/*",
    "https://*.my.salesforce.app/*",
    "https://*.forceusercontent.com/*",
    "https://*.force-user-content.com/*",
    "https://*.salesforce-scrt.com/*"
  ],
  "action": {
    "default_title": "ForcePilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.vf.force.com/*"
      ],
      "js": [
        "src/launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "branding/forcepilot-icon.png"
      ],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.vf.force.com/*"
      ]
    }
  ],
  "short_name": "ForcePilot",
  "commands": {
    "open-forcepilot": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Open ForcePilot on the current Salesforce tab"
    }
  }
}