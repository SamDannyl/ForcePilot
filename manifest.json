{
  "manifest_version": 3,
  "name": "ForcePilot - Salesforce Record Autofill",
  "version": "1.5",
  "description": "Record Salesforce field values and reuse them to autofill similar records.",
  "incognito": "split",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.vf.force.com/*"
  ],
  "action": {
    "default_title": "ForcePilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.vf.force.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.vf.force.com/*"
      ],
      "js": [
        "page_bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "branding/forcepilot-icon.png"
      ],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.vf.force.com/*"
      ]
    }
  ],
  "short_name": "ForcePilot"
}
